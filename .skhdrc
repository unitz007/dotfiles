# App Shortcuts
alt - g : open -a 'Goland'
alt - j : open -a 'IntelliJ IDEA'
alt - v : open -a 'Fleet'
alt - z : open -a 'Zed'
alt - b : open -a 'Safari'
alt - c : open -a 'Claude'
alt - s : open -a 'Settings'
alt - t : open -a 'Ghostty'
alt - m : open -a 'Mail'
alt - p : open -a 'Postman'
alt - w : open -a 'Whatsapp'
alt - f : open -a 'Finder'
alt - n : open -a 'Notes'
alt - i : open -a 'Microsoft Teams'
alt - h : open -a 'Google Chrome'
alt - d : open -a 'Dictionary'
alt - a : open -a 'Preview'
alt - y : open -a 'PyCharm Community Edition'
