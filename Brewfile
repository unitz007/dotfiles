brew "zsh"
brew "ripgrep"
brew "fd"
brew "git"
brew "yazi"
brew "skhd"
brew "node"
brew "gcc"

# Casks — GUI applications referenced across the dotfiles
cask "kitty"
cask "aerospace"
cask "karabiner-elements"
cask "font-jetbrains-mono-nerd-font"
