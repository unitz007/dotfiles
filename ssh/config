# SSH Client Configuration
# Managed by dotfiles — customize per-user as needed.
# This template provides sensible defaults for connection multiplexing,
# keep-alive, and common identity files. Uncomment and modify the
# example host blocks below for your specific hosts.

# --- Global defaults ---
Host *
  # Connection multiplexing: reuse a single SSH connection for multiple sessions
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600

  # Keep-alive: send a heartbeat every 60 seconds, disconnect after 3 misses
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Common identity files (tried in order)
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_rsa

  # Add keys to the SSH agent automatically
  AddKeysToAgent yes

  # Store passphrases in macOS Keychain (harmless on Linux)
  UseKeychain yes

  # Enable compression for faster transfers on slow links
  Compression yes

